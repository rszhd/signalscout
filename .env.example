# Copy to .env. `pnpm dev` does that for you if .env is missing.
# No real values belong in this file; it is committed.

# ---------------------------------------------------------------- application

# development | test | production
NODE_ENV=development

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# The port the API listens on, inside the container and on the host.
PORT=3000
HOST=0.0.0.0

# true  — one process runs the API and the worker. The default; ~120 MB.
# false — the worker runs as a second container from the same image. When you
#         set this to false, also set COMPOSE_PROFILES=worker below, so
#         `docker compose up` starts that container.
WORKER_IN_PROCESS=true

# Absolute path to the built UI. Leave empty to use the build next to the API.
WEB_DIST_PATH=

# ------------------------------------------------------------------- database

# Read by the app, by `pnpm dev` and by `pnpm test`. Inside compose the app
# reaches Postgres as `postgres`, so compose sets its own value there; this one
# is the value host processes use.
DATABASE_URL=postgres://intentwatch:intentwatch@localhost:5432/intentwatch

# Compose creates the database from these. Change the password before you put
# this anywhere other than your own machine, and change DATABASE_URL with it.
POSTGRES_USER=intentwatch
POSTGRES_PASSWORD=intentwatch
POSTGRES_DB=intentwatch

# ------------------------------------------------------------------- secrets

# Encrypts credentials stored in the database. Base64 of 32 bytes:
#
#     openssl rand -base64 32
#
# Leave it empty while your keys live in this file. An environment variable
# needs no encryption — it is already outside the database and outside git —
# and nothing in the application writes an encrypted credential yet.
#
# Once one is stored, this stops being optional: the API and the worker decrypt
# every stored credential at boot and refuse to start if they cannot. Losing
# this value loses those credentials. docs/secrets.md has the rotation steps.
ENCRYPTION_KEY=

# -------------------------------------------------------------------- sources

# One variable per credential a connector asks for, named
# <SOURCE>_<FIELD>. The name is the source you connect, never the provider
# behind it: you connect Reddit, and which company serves it is our problem.
#
# US-004 added an encrypted table beside this, and the application prefers a
# stored credential when there is one. Nothing writes that table yet, so these
# variables are still where every instance keeps its keys. See docs/secrets.md.

# Reddit arrives through Bright Data, not through Reddit's own API: Reddit
# closed self-serve app registration in November 2025 and now approves
# developers by hand. A Bright Data account is self-serve and its free tier
# needs no card — 5,000 records a month, then $1.50 per 1,000.
# Get the key at https://brightdata.com. The README says what this means.
REDDIT_API_KEY=

# Your own X app, from https://developer.x.com. Pay-per-use is the only
# self-serve path since February 2026, and there is no free tier: every post
# read costs $0.005. Set a budget on the monitor before you use this.
X_API_KEY=
X_API_SECRET=

# ------------------------------------------------------------------- the model

# The model that scores posts against a monitor. One provider, chosen here.
#
#   openai | anthropic | google | openrouter | ollama
#
# Bring your own key. Nothing is sent to us, and the classification runs
# wherever this points. `ollama` needs no key and reaches
# http://localhost:11434/v1, so a local model is these two lines and no code
# change.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
AI_API_KEY=

# Point the client somewhere else: a self-hosted gateway, an OpenAI-compatible
# server, or an Ollama that is not on localhost. Empty uses the provider's own.
AI_BASE_URL=

# How long one classification may take, in milliseconds. A local model on a
# small machine is slower than an API.
AI_TIMEOUT_MS=30000

# What the model costs, in micro-dollars per million tokens — millionths of a
# dollar, so $1.00 per million is 1000000. Set these only for a model whose
# price we do not carry; without them the call is recorded with no cost rather
# than with a guessed one.
AI_INPUT_PRICE_MICROS=
AI_OUTPUT_PRICE_MICROS=

# --------------------------------------------------------------- the embedding

# The model that embeds posts for the pre-filter, which drops the obvious
# misses before the classifier is paid to read them. An embedding costs about
# one hundredth of a classification.
#
#   openai | google | openrouter | ollama
#
# Anthropic has no embedding endpoint, so a deployment on the default provider
# has to name another one here. Leave it empty and the pre-filter still runs
# its free keyword stage; everything that survives reaches the model. Nothing
# is dropped by a stage that is not running.
#
# The model must return 1536 numbers per embedding, because that is the width
# the database stores. A model of another width is refused with a message
# rather than written. Empty uses text-embedding-3-small on OpenAI, and has no
# default anywhere else.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=
# Empty reuses AI_API_KEY, but only when the two providers are the same.
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=

# What the embedding model costs, in micro-dollars per million tokens. We carry
# no price table for these, so the call is recorded with no cost until this is
# set. Read the number off your provider's own pricing page: a guessed price
# would look exactly like a measured one on the monitor list.
AI_EMBEDDING_PRICE_MICROS=

# -------------------------------------------------------------------- compose

# The published image the server pulls. It never compiles anything.
INTENTWATCH_IMAGE=ghcr.io/intentwatch/intentwatch:latest

# Leave empty for one container. Set to `worker` to start the second one.
COMPOSE_PROFILES=
