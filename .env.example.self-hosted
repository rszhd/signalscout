# The settings a self-hosted instance sets. `pnpm setup` copies this to .env.
#
# Everything absent from this file has a default that is already the
# self-hosted answer, so a short .env boots. `.env.example` is the full list —
# every variable the application reads, with the reasoning beside each one.
# Read it when you want a dial this file does not offer.
#
# No real values belong in this file; it is committed.

# -------------------------------------------------------------------- secrets

# `pnpm setup` writes both of these and never overwrites them. On a server with
# no Node, generate them yourself:
#
#     echo "AUTH_SECRET=$(openssl rand -base64 32)" >> .env
#     echo "ENCRYPTION_KEY=$(openssl rand -base64 32)" >> .env

# Signs the session cookie. The app refuses to start without it: an instance
# with no login serves its inbox and its money-spending keys to whoever finds
# the port, and every screen works, which is why nobody would notice.
AUTH_SECRET=

# Encrypts the keys you paste on the Connections and Models screens. Losing it
# loses those keys. docs/secrets.md has the rotation steps.
ENCRYPTION_KEY=

# ------------------------------------------------------------------- database

# Change the password before this answers on a public address, and change
# DATABASE_URL with it. Change both before the first `docker compose up`:
# changing them afterwards locks the app out of a volume that already exists.
POSTGRES_USER=intentwatch
POSTGRES_PASSWORD=intentwatch
POSTGRES_DB=intentwatch

# Only host processes read this — `pnpm dev` and `pnpm test`. Inside compose
# the app reaches Postgres as `postgres`, and the compose file builds its own
# value from the three above.
DATABASE_URL=postgres://intentwatch:intentwatch@localhost:5432/intentwatch

# -------------------------------------------------------------------- sources

# A provider key buys the conversations. You need one for each platform you
# want to watch, and one is a useful product: a platform with no key cannot be
# ticked on the monitor form.
#
# The variable is named after the provider, never the platform — one
# SocialCrawl key serves five platforms, so it is pasted once and rotated once.
#
# You can leave every one of these empty and paste the key on the Connections
# screen instead. There it is tested with the provider before it is stored,
# encrypted, and owned by the account that pasted it. A key here belongs to the
# machine, and every account on it polls with yours.

# Reddit. A free tier that needs no card: brightdata.com
BRIGHTDATA_API_KEY=

# Reddit, and far cheaper per post than Bright Data: scrapecreators.com
SCRAPECREATORS_API_KEY=

# Reddit, X, LinkedIn, YouTube, TikTok and Instagram: socialcrawl.dev
SOCIALCRAWL_API_KEY=

# X, and the account is prepaid: socialdata.tools
# Quote the value. This key can contain a pipe character, and an unquoted line
# makes the shell run the second half as a command and load an empty key —
# which looks exactly like a missing one.
SOCIALDATA_API_KEY=''

# LinkedIn, and the only provider that finds a post an hour old: apify.com
APIFY_API_TOKEN=

# Where a platform has two providers, the Connections screen asks you once and
# stores the answer. Until you answer, a poll refuses to start rather than pick
# for you, because picking would spend money at a provider you did not choose.

# ------------------------------------------------------------------ the model

# A model key reads the conversations. Bring your own: nothing is sent to us,
# and the classification runs wherever this points.
#
#   openai | anthropic | google | openrouter | ollama
#
# `ollama` needs no key and reaches http://localhost:11434/v1, so a local model
# is these two lines and no code change. As with the provider keys, you can
# leave these empty and paste the key on the Models screen instead.
AI_PROVIDER=anthropic
AI_MODEL=claude-haiku-4-5
AI_API_KEY=

# The pre-filter's similarity stage, which drops the obvious misses before the
# model is paid to read them. Anthropic publishes no embedding endpoint, so on
# the default provider this needs another one named or the stage does not run.
# Nothing is dropped by a stage that is off; it costs money rather than leads.
# Empty uses text-embedding-3-small on OpenAI.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_API_KEY=

# The model that reads everything before the scorer does, in one word.
# **Name a model cheaper than AI_MODEL, or this stage costs you money.** It is
# measured: with a scorer ten times dearer the bill fell 48%, and with the same
# model on both stages it rose 48%. Empty means the scorer's own model, and the
# worker warns at startup when the two match. docs/costs.md has the arithmetic.
AI_TRIAGE_MODEL=

# --------------------------------------------------------------- notification

# Optional. With no SMTP_HOST the notification screen names what is missing
# rather than queueing mail nobody posted. Resend: smtp.resend.com, port 465,
# secure true, user `resend`, password your API key, and SMTP_FROM an address
# on a domain you verified. docs/notifications.md has the rest.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Signs every outgoing webhook, so your receiver can prove a delivery is ours.
# Generate with `openssl rand -hex 32` and set the same value there.
WEBHOOK_SIGNING_SECRET=

# -------------------------------------------------------------------- serving

# The port the app listens on, in the container and on the host.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# true  — one process runs the API and the worker. The default; about 120 MB.
# false — the worker gets its own container from the same image. Set
#         COMPOSE_PROFILES=worker with it, or you end up with no worker.
WORKER_IN_PROCESS=true
COMPOSE_PROFILES=

# ------------------------------------------------------------------------ TLS

# Put this behind TLS before you give it a public address: it holds keys that
# spend money, and on plain HTTP the session cookie is readable in transit.
#
# Only docker-compose.prod.yml and docker-compose.proxy.yml read these two, so
# on localhost they are unused. APP_HOST is the hostname the browser uses, and
# ACME_EMAIL is where Let's Encrypt sends expiry warnings. If a proxy you
# already run terminates TLS, leave ACME_EMAIL empty and read
# docs/self-hosting.md for the other path.
APP_HOST=
ACME_EMAIL=

# --------------------------------------------------------------- one more you

# Letting somebody else register, proving an address by email, or charging for
# this instance are three settings this file leaves out, because all three
# default to the answer a machine you run for yourself wants. `.env.example`
# holds them, and docs/accounts.md holds what changing them means.
