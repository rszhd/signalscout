# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Environment and secrets. Both example files are committed and every other
# `.env.` file is somebody's real values, so each exception is named rather
# than globbed: `!.env.example*` would also un-ignore a `.env.example.local`
# that a person made by copying one of them.
.env
.env.*
!.env.example
!.env.example.self-hosted

# Logs and coverage
*.log
npm-debug.log*
coverage/

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Worktrees made by `scripts/new-worktree.mjs`. They live inside the checkout so
# that opening the main folder in an editor shows every worktree's changes in
# one source-control view. Each one is a working tree of this same repository,
# so it must not also be untracked content *of* it: without this line
# `git status` reports the folder, and Biome — which reads this file — walks
# every worktree on every `pnpm lint`.
worktrees/

# Third-party agent skills. `skills-lock.json` is committed and the installed
# files are not, the way a lockfile is committed and `node_modules` is not:
# `npx skills add` restores them from the lock. Third-party entries in
# `.claude/skills/` are symlinks into `.agents/`, which would be broken links
# for anyone else. This repository's own skills are listed below and kept.
.agents/
.claude/skills/*
!.claude/skills/add-migration/
!.claude/skills/capture-fixture/
!.claude/skills/measure-scoring-change/
!.claude/skills/cut-release/
!.claude/skills/worktree/

# `live:triage-score` writes one file per run. They hold excerpts of real
# posts from a live database, so they stay out of the repository; the numbers
# that matter go in the ticket.
triage-score-*.json
triage-score-cache-*.json
triage-score-cache-*.json.tmp

# The eval dataset is built from a run record and a database, and it carries
# real people's post text. `pnpm eval:dataset` rebuilds it in seconds.
evals/*/dataset.json

# The documentation site's build and cache (US-342).
site/.vitepress/cache/
site/.vitepress/dist/
