# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.turbo/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Logs and coverage
*.log
npm-debug.log*
coverage/

# Editor and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Third-party agent skills. `skills-lock.json` is committed and the installed
# files are not, the way a lockfile is committed and `node_modules` is not:
# `npx skills add` restores them from the lock. `.claude/skills/` holds only
# symlinks into `.agents/`, which would be broken links for anyone else.
.agents/
.claude/skills/
