{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/drizzle",
      "!mockup",
      "!pnpm-lock.yaml",
      "!packages/core/src/sources/*/fixtures/*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "fastify": "packages/core imports neither Fastify nor React. See AGENTS.md.",
                  "react": "packages/core imports neither Fastify nor React. See AGENTS.md.",
                  "react-dom": "packages/core imports neither Fastify nor React. See AGENTS.md.",
                  "react-router": "packages/core imports neither Fastify nor React. See AGENTS.md."
                }
              }
            }
          }
        }
      }
    }
  ]
}
