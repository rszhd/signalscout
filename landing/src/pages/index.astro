---
import "@fontsource/figtree/400.css";
import "@fontsource/figtree/500.css";
import "@fontsource/figtree/600.css";
import "@fontsource/figtree/700.css";
import "../styles/tokens.css";
import "../styles/landing.css";
import "../styles/features.css";
import Icon from "../components/Icon.astro";

const repository = "https://github.com/rszhd/signalscout";
const appUrl = import.meta.env.PUBLIC_APP_URL;
const platforms = [
  ["Reddit", "reddit.png"],
  ["X / Twitter", "x.png"],
  ["LinkedIn", "linkedin.ico"],
  ["YouTube", "youtube.png"],
  ["TikTok", "tiktok.png"],
  ["Instagram", "instagram.png"],
];
const heroPosts = [
  {
    icon: "reddit.png",
    source: "Reddit · r/smallbusiness",
    product: "a booking app",
    score: 94,
    text: "My clients keep booking the same slot twice.",
    signal: "Is there a scheduling tool that stops this?",
  },
  {
    icon: "x.png",
    source: "X · Backend developer",
    product: "an error monitor",
    score: 88,
    text: "Our alerts are buried under a hundred other emails.",
    signal: "What do you all use to catch them?",
  },
  {
    icon: "linkedin.ico",
    source: "LinkedIn · Operations lead",
    product: "a hiring tracker",
    score: 87,
    text: "We are hiring out of a spreadsheet of forty candidates.",
    signal: "Is there anything simpler than a full ATS?",
  },
  {
    icon: "youtube.png",
    source: "YouTube · Comment",
    product: "a subtitle editor",
    score: 91,
    text: "Fixing the subtitles takes me longer than filming did.",
    signal: "Can a tool do this for me?",
  },
  {
    icon: "tiktok.png",
    source: "TikTok · Comment",
    product: "a skincare line",
    score: 86,
    text: "This moisturiser broke me out within a week.",
    signal: "What should I be using instead?",
  },
  {
    icon: "instagram.png",
    source: "Instagram · Comment",
    product: "a meal planner",
    score: 90,
    text: "I throw out half my groceries every single week.",
    signal: "Does anyone have a planner they like?",
  },
];
const overheard = [
  "can someone recommend…",
  "there has to be a better way to…",
  "what do you all use for…",
  "is there anything simpler than…",
  "does anyone know a tool that…",
];
const examples = [
  {
    label: "Needs an app",
    source: "Reddit · r/freelance",
    score: 94,
    title: "I want my Fridays back.",
    quote:
      "I’m a freelance designer and spend every Friday chasing unpaid invoices. Is there a simple app that sends reminders for me?",
    reason: "Chasing payments costs them time. They’re asking for an app to do it.",
    tags: ["Freelancer", "Chasing late payments", "Looking for an app"],
  },
  {
    label: "Ready to switch",
    source: "X / Twitter",
    score: 89,
    title: "I just need to send invoices and get paid.",
    quote:
      "My accounting software is expensive and has a hundred features I never use. Any simpler invoicing apps for a solo freelancer?",
    reason: "Their current tool costs too much. They want a simpler replacement.",
    tags: ["Too expensive", "Wants something simpler", "Ready to switch"],
  },
  {
    label: "Sharing advice",
    source: "Reddit · r/freelance",
    score: 18,
    title: "My tips for getting invoices paid on time.",
    quote:
      "I wrote a guide to setting clear payment terms and following up with clients. Here are five tips that work for me.",
    reason: "Sharing advice. No problem to solve, no request for help.",
    tags: ["Related topic", "Sharing expertise", "No request for help"],
  },
];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="description" content="Someone is asking for what you built. SignalScout finds public posts and comments from people describing a problem your product solves. Open source. Self-hostable."/>
<meta name="theme-color" content="#f7f8fa"/>
<meta property="og:title" content="SignalScout — Someone is asking for what you built."/>
<meta property="og:description" content="Find the question your product answers. Open-source AI intent monitoring across six platforms."/>
<meta property="og:type" content="website"/>
<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
<title>SignalScout — Someone is asking for what you built</title>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap">
  <a href="#" class="wordmark" aria-label="SignalScout home"><span class="logo-mark"><Icon name="signal" size={23}/></span>SignalScout<span class="wordmark-dot">.</span></a>
  <nav aria-label="Main navigation"><a href="#how-it-works">How it works</a><a href="#features">Features</a><a href="#pricing">Pricing</a><a class="github-link" href={repository}><Icon name="github" size={18}/>GitHub</a></nav>
  <a class="button small" href="#pricing">Get started <Icon size={16}/></a>
</header>
<main id="main">
<section class="hero wrap">
  <div class="hero-copy">
    <span class="eyebrow"><span class="status-dot"></span> FOR THE THINGS YOU BUILD</span>
    <h1>Someone is<br/>asking for<br/><span class="headline-accent">what you built.</span></h1>
    <p class="hero-description">SignalScout finds posts and comments from people with a problem your product solves.</p>
    <div class="hero-actions"><a class="button" href="#inbox">Find the question <Icon size={18}/></a><a class="text-link" href={repository}>Self-host it <Icon name="github" size={18}/></a></div>
    <p class="hero-note">Open source. Your keys. Your data.</p>
  </div>
  <div class="signal-scene" aria-label="Illustrative matches for six different products">
    <span class="scene-label">SOMEWHERE IN THE COMMENTS</span>
    <div class="question-mark" aria-hidden="true">?</div>
    <div class="floating-note note-one"><img src="/brands/x.png" alt="X" width="18" height="18"/>“Ten tips I learned the hard way.”<span>Skip</span></div>
    <div class="hero-deck" id="hero-deck" aria-live="off">
    {heroPosts.map((post, index) => (
      <article class="signal-card" data-hero-card aria-hidden={index !== 0}>
        <div class="signal-card-top"><span class="platform-meta"><img src={`/brands/${post.icon}`} alt="" width="21" height="21"/>{post.source}</span><span class="match-badge">Worth a look ↗</span></div>
        <p>“{post.text} <mark>{post.signal}</mark>”</p>
        <div class="card-bottom"><span>You build <strong>{post.product}</strong></span><span class="score">{post.score}<span>/100</span></span></div>
      </article>
    ))}
    </div>
    <span class="found-label"><Icon name="signal" size={18}/> That’s your cue.</span>
    <div class="hero-rotation-controls" hidden><button type="button" data-hero-toggle aria-controls="hero-deck" aria-label="Pause post rotation">Pause</button><span data-hero-position>1 / {heroPosts.length}</span><button type="button" data-hero-next aria-controls="hero-deck" aria-label="Show next example post">Next <Icon size={13}/></button></div>
    <span class="illustration-label">Six platforms. Six different things somebody built.</span>
  </div>
</section>
<section class="platform-strip wrap" aria-label="Supported platforms">
  <span class="eyebrow">SIX PLACES TO LISTEN</span>
  <div class="platform-list">{platforms.map(([name,file]) => <span><img src={`/brands/${file}`} width="21" height="21" alt=""/>{name}</span>)}</div>
</section>
<section id="inbox" class="demo-section section-space">
<div class="wrap">
  <div class="section-heading"><span class="eyebrow">01 / SPOT THE DIFFERENCE</span><h2>Same keyword.<br/><span>Different story.</span></h2><p>AI reads for need, fit, and intent.<br/>You get a score and the reason behind it.</p></div>
<div class="demo-shell" data-examples={JSON.stringify(examples)}>
<div class="demo-bar">
<span>
<Icon name="inbox" size={18}/>Your intent inbox</span>
<span class="sample-label">Example monitor: freelancer invoicing app</span>
</div>
<div class="demo-content">
<div class="example-list">
<p class="eyebrow">THREE POSTS. ONE TOPIC.</p>{examples.map((example,index)=>
<button class:list={['example-button',{selected:index===0}]} data-example={index} aria-pressed={index===0} aria-controls="example-detail">
<span class="example-number">0{index+1}</span>
<span>{example.label}<small>{example.source}</small>
</span>
<Icon size={17}/>
</button>)}<p class="sample-note">Illustrative posts and scores.</p>
</div>
<div id="example-detail" class="example-detail" aria-live="polite" aria-atomic="true">
<div class="detail-meta">
<span id="example-source">{examples[0].source}</span>
<div class="score-summary">
<span id="example-status" class="score-pill" data-score-tone={examples[0].score >= 80 ? "high" : examples[0].score >= 55 ? "medium" : "low"}>{examples[0].score >= 80 ? "High intent" : examples[0].score >= 55 ? "Worth reading" : "Low intent"}</span>
<span class="detail-score">
<strong id="example-score" data-score-tone={examples[0].score >= 80 ? "high" : examples[0].score >= 55 ? "medium" : "low"}>{examples[0].score}</strong> / 100 <span>match score</span>
</span>
</div>
</div>
<h3 id="example-title">{examples[0].title}</h3>
<blockquote id="example-quote">“{examples[0].quote}”</blockquote>
<div class="model-reason">
<span class="eyebrow">
<span class="sparkle">✦</span>What the model saw</span>
<p id="example-reason">{examples[0].reason}</p>
</div>
<div class="tags" id="example-tags">{examples[0].tags.map(tag=>
<span>{tag}</span>)}</div>
</div>
</div>
</div>

</div>
</section>
<section id="how-it-works" class="workflow wrap section-space">
  <div class="section-heading"><span class="eyebrow">02 / YOUR PART IS SIMPLE</span><h2>Describe it.<br/><span>Then go build it.</span></h2></div>
  <div class="steps">
    <article><span class="step-number">01</span><h3>Tell us who you help.</h3><p>Your product, their problem, the platforms to watch.</p></article>
    <article><span class="step-number">02</span><h3>Let the monitor run.</h3><p>Set a schedule and budget. Get matches by inbox, email, or webhook.</p></article>
    <article><span class="step-number">03</span><h3>Join when you can help.</h3><p>Read the post. Draft a reply. You edit and post it yourself.</p></article>
  </div>
</section>
<section id="features" class="features wrap section-space" aria-labelledby="features-title">
  <div class="section-heading"><span class="eyebrow">03 / KEEP THE GOOD ONES</span><h2 id="features-title">A question found.<br/><span>A conversation started.</span></h2><p>Read it. Save it. Reply when you can help.</p></div>
  <div class="feature-grid">
    <article class="feature-card feature-inbox">
      <h3>Six platforms. One place to look.</h3>
      <p>Posts and comments, scored against your product. The reason for every match is right beside it.</p>
      <div class="feature-platforms" aria-label="Supported platforms">{platforms.map(([name, file]) => <span><img src={`/brands/${file}`} alt="" width="20" height="20"/>{name}</span>)}</div>
      <div class="feature-signal"><span class="score-pill" data-score-tone="high">High intent</span><span>“Is there a simple app that sends reminders for me?”</span><strong>94<span> / 100</span></strong></div>
      <span class="feature-note">Illustrative match for a freelancer invoicing app</span>
      <a class="text-link" href="#inbox">Explore the example <Icon size={17}/></a>
    </article>
    <article class="feature-card feature-alerts">
      <h3>Let the good ones come to you.</h3>
      <p>Daily digests, immediate email alerts, or webhooks. Pick your delivery.</p>
      <div class="feature-digest">
        <div><Icon name="bell" size={17}/><strong>SignalScout digest</strong></div>
        <p>A designer wants an app to chase late payments.</p>
        <span>Reddit · r/freelance</span>
        <small>Illustrative email preview</small>
      </div>
    </article>
    <article class="feature-card">
      <h3>Skip the blank reply box.</h3>
      <p>Draft with context and your chosen voice. Edit it, then post it yourself.</p>
      <span class="feature-footnote">You review. You hit send.</span>
    </article>
    <article class="feature-card">
      <h3>Put a number on it.</h3>
      <p>Estimate costs. Set a schedule and monthly cap. Track what each monitor spends.</p>
      <span class="feature-footnote">Your schedule. Your spending limit.</span>
    </article>
    <article class="feature-card">
      <h3>Bring your keys. Keep control.</h3>
      <p>Choose your data providers and AI models. Run it yourself or let us host it.</p>
      <a class="text-link" href={repository}>Read the source <Icon name="external" size={17}/></a>
    </article>
  </div>
</section>
<section id="pricing" class="pricing-section section-space">
<div class="wrap">
  <div class="section-heading"><span class="eyebrow">04 / MAKE IT YOURS</span><h2>Your server.<br/><span>Or ours.</span></h2><p>The full app, either way.<br/>Bring your own data and AI provider keys.</p></div>
  <div class="plans">
    <article class="plan"><div class="plan-top"><h3>Self-hosted</h3><Icon name="github" size={26}/></div><p class="price">$0<span> / software</span></p><p>Full source. Docker Compose. Your infrastructure.</p><a class="button secondary" href={`${repository}#running-it`}>Get the code <Icon size={18}/></a></article>
    <article class="plan cloud-plan"><div class="plan-top"><h3>SignalScout Cloud</h3><Icon name="signal" size={26}/></div><p class="price">$15<span> USD / month</span></p><p>We run the app and scheduler. You keep building.</p>{appUrl ? <a class="button" href={appUrl}>Start on Cloud <Icon size={18}/></a> : <span class="cloud-status">Cloud signup coming soon</span>}</article>
  </div>
  <p class="pricing-note">Social data and AI usage cost extra on both plans, billed by your providers.</p>
</div>
</section>
<section id="faq" class="faq wrap section-space">
  <div class="section-heading"><span class="eyebrow">05 / BEFORE YOU START</span><h2>A few things<br/><span>worth asking.</span></h2></div>
  <div class="faq-list">
    <details><summary>How is this different from keyword alerts?</summary><p>Keywords find the topic. AI checks whether the person needs what you sell, then explains its score.</p></details>
    <details><summary>Which keys do I need?</summary><p>A supported social-data provider account, plus an AI provider or supported local model. No direct social-platform API key needed.</p></details>
    <details><summary>Will it post for me?</summary><p>No. SignalScout can draft a reply. You review it and post it yourself.</p></details>
    <details><summary>Can I run the whole app myself?</summary><p>Yes. The full application is open source and runs with Docker Compose. You pay for your infrastructure and provider usage.</p></details>
  </div>
</section>
<section class="closing">
  <div class="wrap">
    <div class="overheard" aria-hidden="true">{overheard.map((line, index) => <span style={`--step:${index}`}>“{line}”</span>)}</div>
    <h2>Maybe they <span>mean yours.</span></h2>
    <p class="closing-line">Six platforms. Somebody is halfway through the question.</p>
    <a class="button" href="#pricing">Start listening <Icon size={20}/></a>
  </div>
</section>
</main>
<footer class="wrap"><a href="#" class="wordmark">SignalScout.</a><p>Built for the conversation worth joining.</p><a class="text-link" href={repository}>Open source on GitHub <Icon name="external" size={15}/></a></footer>
<script>
import '../scripts/hero-rotation';
</script>
<script is:inline>
const demo = document.querySelector('[data-examples]');
const examples = JSON.parse(demo.dataset.examples);
document.querySelectorAll('[data-example]').forEach(button => {
  button.addEventListener('click', () => {
    const example = examples[Number(button.dataset.example)];
    const tone = example.score >= 80 ? "high" : example.score >= 55 ? "medium" : "low";
    document.getElementById("example-score").dataset.scoreTone = tone;
    const status = document.getElementById("example-status");
    status.dataset.scoreTone = tone;
    status.textContent = tone === "high" ? "High intent" : tone === "medium" ? "Worth reading" : "Low intent";
    document.querySelectorAll('[data-example]').forEach(item => {
      item.setAttribute('aria-pressed', String(item === button));
      item.classList.toggle('selected', item === button);
    });
    for (const key of ['source', 'score', 'title', 'reason']) {
      document.getElementById(`example-${key}`).textContent = String(example[key]);
    }
    document.getElementById('example-quote').textContent = `“${example.quote}”`;
    document.getElementById('example-tags').replaceChildren(...example.tags.map(tag => {
      const span = document.createElement('span');
      span.textContent = tag;
      return span;
    }));
  });
});
</script>
</body>
</html>
