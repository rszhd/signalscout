{
  "name": "signalscout",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/init-env.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node scripts/dev.mjs",
    "preview": "node scripts/preview.mjs",
    "build": "tsc --build && pnpm --filter @signalscout/web build",
    "typecheck": "tsc --build && pnpm --filter @signalscout/web typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:css": "stylelint --config stylelint.config.mjs \"apps/web/src/styles/theme.css\" \"apps/web/src/styles/reply-draft.css\"",
    "check:licenses": "node scripts/check-licenses.mjs",
    "format": "biome check --write .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @signalscout/api migrate",
    "db:generate": "pnpm --filter @signalscout/pipeline generate && pnpm --filter @signalscout/api generate",
    "db:rotate-key": "pnpm --filter @signalscout/pipeline rotate-key",
    "capture:deletions": "node --env-file=.env packages/engine/src/sources/deletion-fixtures/capture.mjs",
    "release:verify": "node scripts/verify-packed.mjs",
    "eval:dataset": "node evals/triage/build-dataset.mjs",
    "eval:triage": "promptfoo eval -c evals/triage/promptfooconfig.yaml --no-cache -j 12",
    "eval:view": "promptfoo view -n",
    "eval:summary": "node evals/triage/summarise.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@signalscout/engine": "workspace:*",
    "@types/node": "26.4.1",
    "ai": "7.0.106",
    "concurrently": "10.0.5",
    "pg": "8.16.3",
    "promptfoo": "0.123.1",
    "stylelint": "17.15.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
