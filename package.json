{
  "name": "signalscout",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/init-env.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc --build && pnpm --filter @signalscout/web build && pnpm --filter @signalscout/admin build",
    "typecheck": "tsc --build && pnpm --filter @signalscout/web typecheck && pnpm --filter @signalscout/admin typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:css": "stylelint --config stylelint.config.mjs \"apps/web/src/styles/theme.css\" \"apps/web/src/styles/reply-draft.css\"",
    "check:licenses": "node scripts/check-licenses.mjs",
    "format": "biome check --write .",
    "db:up": "docker compose up -d postgres",
    "db:migrate": "pnpm --filter @signalscout/core migrate",
    "db:generate": "pnpm --filter @signalscout/core generate",
    "db:rotate-key": "pnpm --filter @signalscout/core rotate-key",
    "capture:deletions": "node --env-file=.env packages/core/src/sources/deletion-fixtures/capture.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "26.4.1",
    "concurrently": "10.0.5",
    "stylelint": "17.15.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
