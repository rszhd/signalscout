{
  "name": "@signalscout/pipeline",
  "version": "0.0.0",
  "description": "The stateful half of SignalScout: monitors, posts, matches, cursors, the budget guard and the jobs, with their migrations.",
  "license": "FSL-1.1-ALv2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rszhd/signalscout.git",
    "directory": "packages/pipeline"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo",
    "drizzle"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "generate": "drizzle-kit generate",
    "generate:email-mark": "tsx src/notifications/email-mark-generate.ts",
    "rotate-key": "tsx --env-file-if-exists=../../.env src/secrets/rotate-cli.ts",
    "live:provider-switch": "tsx --env-file-if-exists=../../.env src/sources/live-provider-switch.ts",
    "live:linkedin-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=linkedin",
    "live:apify-linkedin-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=linkedin --provider=apify",
    "live:harvestapi-linkedin-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=linkedin --provider=harvestapi",
    "live:x-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=x --provider=socialdata",
    "live:sc-tiktok-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=tiktok --provider=scrapecreators",
    "live:sc-youtube-poll": "tsx --env-file-if-exists=../../.env src/sources/live-poll.ts --platform=youtube --provider=scrapecreators",
    "live:reddit-replies": "tsx --env-file-if-exists=../../.env src/sources/live-reddit-replies-poll.ts",
    "live:reddit-replies-finish": "tsx --env-file-if-exists=../../.env src/sources/live-reddit-replies-finish.ts",
    "live:youtube-poll": "tsx --env-file-if-exists=../../.env src/sources/live-youtube-poll.ts",
    "live:tiktok-poll": "tsx --env-file-if-exists=../../.env src/sources/live-tiktok-poll.ts",
    "live:instagram-poll": "tsx --env-file-if-exists=../../.env src/sources/live-instagram-poll.ts",
    "live:model-probe": "tsx --env-file-if-exists=../../.env src/ai/live-model-probe.ts",
    "live:webhook": "tsx --env-file-if-exists=../../.env src/notifications/live-webhook.ts",
    "live:notification": "tsx --env-file-if-exists=../../.env src/notifications/live-notification.ts",
    "live:tiktok-comments": "tsx --env-file-if-exists=../../.env src/sources/live-tiktok-comments.ts",
    "live:triage-score": "tsx --env-file-if-exists=../../.env src/sources/live-triage-vs-score.ts",
    "live:instagram-comments": "tsx --env-file-if-exists=../../.env src/sources/live-tiktok-comments.ts --platform=instagram",
    "live:thread-loop": "tsx --env-file-if-exists=../../.env src/sources/live-thread-loop.ts",
    "measure:lead-position": "tsx --env-file-if-exists=../../.env src/sources/measure-lead-position.ts"
  },
  "dependencies": {
    "@signalscout/engine": "workspace:*",
    "ai": "7.0.106",
    "drizzle-orm": "0.45.2",
    "nodemailer": "^10.0.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "pino": "10.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      }
    }
  }
}
