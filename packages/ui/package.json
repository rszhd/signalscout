{
  "name": "@signalscout/ui",
  "version": "0.0.0",
  "description": "SignalScout's brand: the token contract, the shared controls, the mark, and the words both applications say about a monitor.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rszhd/signalscout.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./tokens.css": {
      "development": "./src/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    },
    "./theme.css": {
      "development": "./src/styles/theme.css",
      "default": "./dist/styles/theme.css"
    },
    "./mark.svg": {
      "development": "./src/assets/mark.svg",
      "default": "./dist/assets/mark.svg"
    },
    "./mark-small.svg": {
      "development": "./src/assets/mark-small.svg",
      "default": "./dist/assets/mark-small.svg"
    },
    "./project-card.css": {
      "development": "./src/styles/project-card.css",
      "default": "./dist/styles/project-card.css"
    },
    "./reply-voices.css": {
      "development": "./src/styles/reply-voices.css",
      "default": "./dist/styles/reply-voices.css"
    },
    "./reply-draft.css": {
      "development": "./src/styles/reply-draft.css",
      "default": "./dist/styles/reply-draft.css"
    }
  },
  "scripts": {
    "build": "tsc --build && node scripts/copy-static.mjs",
    "typecheck": "tsc --build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "^30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "./tokens.css": "./dist/styles/tokens.css",
      "./theme.css": "./dist/styles/theme.css",
      "./mark.svg": "./dist/assets/mark.svg",
      "./mark-small.svg": "./dist/assets/mark-small.svg",
      "./project-card.css": "./dist/styles/project-card.css",
      "./reply-voices.css": "./dist/styles/reply-voices.css",
      "./reply-draft.css": "./dist/styles/reply-draft.css"
    }
  }
}
